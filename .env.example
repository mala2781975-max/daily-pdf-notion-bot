# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Comma separated chat IDs allowed to use the bot (send /start to the bot to see your ID).
# Also receives the automatic daily-run messages.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Notion ----------
NOTION_API_KEY=
# Page that CONTAINS the "2026" page (year page is auto-created if missing)
NOTION_ROOT_PAGE_ID=
# OR: directly the "2026" page id (if set, this is used as the year page)
NOTION_YEAR_PAGE_ID=

# ---------- PDF source (choose ONE option) ----------
# Option A: direct PDF URL with placeholders {YYYY} {YY} {MM} {DD} {MMM} {MMMM}
PDF_URL_TEMPLATE=
# Option B: a web page that has the PDF link; CSS selector of the <a> to download
PAGE_URL=
PDF_LINK_SELECTOR=a[href$=".pdf"]
# Optional: cookie header if the site needs login
PDF_COOKIE=

# ---------- Behaviour ----------
BATCH_SIZE=10
BATCH_DELAY_MS=4000
DOWNLOAD_RETRIES=12
DOWNLOAD_RETRY_MINUTES=15
# Daily auto-run (cron syntax) and timezone
CRON_SCHEDULE=30 7 * * *
TIMEZONE=Asia/Kolkata
# Title of the date page inside the month page
DATE_TITLE_FORMAT=DD MMM YYYY
